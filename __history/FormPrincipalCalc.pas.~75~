unit FormPrincipalCalc;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes,
  Vcl.Graphics, Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.StdCtrls,
  View.WebCharts, Charts.Types, Vcl.OleCtrls, SHDocVw, ACBrBase,
  ACBrValidador;

type
  TForm1 = class(TForm)
    Edit1: TEdit;
    Edit2: TEdit;
    Edit3: TEdit;
    Button1: TButton;
    Button2: TButton;
    WebCharts1: TWebCharts;
    WebBrowser1: TWebBrowser;
    ACBrValidador1: TACBrValidador;
    Edit4: TEdit;
    procedure Button1Click(Sender: TObject);
    procedure Button2Click(Sender: TObject);
    procedure FormCreate(Sender: TObject);
    procedure ACBrValidador1MsgErro(Mensagem: string);
  public
    function Somar(aNumber1, aNumber2: Integer): Integer;
    function FormatarCPFCNPJ(aValue: string): string;
    procedure SomarDoisNumeros;
  end;

var
  Form1: TForm1;

implementation

{$R *.dfm}


procedure TForm1.FormCreate(Sender: TObject);
begin
  // Monta o layout no componente WebCharts1
  WebCharts1.Container(fluid)
    .BackgroundColor('#262735')
    .FontColor('#FFF')
    .NewProject
    .Jumpline
    .Rows
    ._Div
    .ColSpan(12)
    .Add(
    '<div style="background-color:#323241; color:#ffffff; text-align:center; height: 90px; padding-top:20px">' +
    '<h2>Dashboard Resumo Financeiro</h2>' +
    '</div>'
    )
    .&End
    .&End
    .WebBrowser(WebBrowser1)
    .Generated;

end;

procedure TForm1.ACBrValidador1MsgErro(Mensagem: string);
begin
ACBrValidador1.Documento := '08863675000176';

  if not ACBrValidador1.Validar then
    Edit4.Text := ACBrValidador1.MsgErro;
end;

procedure TForm1.Button1Click(Sender: TObject);
begin
  SomarDoisNumeros;
end;

procedure TForm1.Button2Click(Sender: TObject);
begin
  ShowMessage('iaeeeee');
end;

function TForm1.FormatarCPFCNPJ(aValue: string): string;
var
  I: Integer;
begin
  Result := '';
  for I := 1 to Length(aValue) do
    if aValue[I] in ['0' .. '9'] then
      Result := Result + aValue[I];
end;

function TForm1.Somar(aNumber1, aNumber2: Integer): Integer;
begin
  Result := aNumber1 + aNumber2;
end;

procedure TForm1.SomarDoisNumeros;
var
  n1, n2: Integer;
begin
  n1 := StrToInt(Edit1.Text);
  n2 := StrToInt(Edit2.Text);
  Edit3.Text := IntToStr(Somar(n1, n2));
end;

end.
